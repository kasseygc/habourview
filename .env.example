# Everything runs on this machine or a private network; there is no outside AI service to configure.
# Where the self-hosted model listens. Must be this machine or a private address, or requests are refused.
OLLAMA_URL=http://localhost:11434
# Which local model answers questions and reads notes.
AXON_LLM_MODEL=gemma3:12b
# auto (default): use a recording if there is one, else ask the local model | replay | record | live
AXON_LLM_MODE=
# Name detector used for redaction: en_core_web_lg (default) or en_core_web_sm
AXON_NAME_MODEL=en_core_web_lg
